{
  "reviewed": true,
  "theme": "retry",
  "notes": "Issue #30, fourth package; same decisions as breaker, rate and cache (see scm/docs/package-layout-migration-map.md), with three differences. (1) The public RetryLayer was a concrete struct that carried the reqwest-middleware impl; an impl of a foreign trait must live in the crate that defines the type, so the struct moves to -std as the private PolicyRetryLayer and RetryLayer becomes a contract trait (Middleware + Debug); DecorateResponse.layer is now Arc<dyn RetryLayer>. (2) RetryConfig, RetryConfigBuilder and ApplicationConfigBuilder keep their inherent impls, so those impls move into -api with their types; ApplicationConfigBuilder::new becomes public because -std must construct it. (3) ApplicationConfigBuilder::new keeps seeding the pre-split application name (configbuilder uses it as a config search directory). HttpRetrySvc becomes the private processor implementation reached through StdRetryFactory.create_processor(). api/default held only a placeholder type alias and is dropped.",
  "api_to_std": {
    "types/retry/retry_layer.rs": "core/retry_layer.rs",
    "types/http_retry_svc.rs": "core/svc_processor.rs"
  },
  "core_to_api": {
    "core/policy.rs": "types/retry/policy.rs",
    "core/policy_builder.rs": "types/retry/policy_builder.rs",
    "core/application_config_builder.rs": "types/application_config_builder_impls.rs"
  },
  "drop": [
    "mod.rs",
    "types/mod.rs",
    "types/retry/mod.rs",
    "traits/mod.rs",
    "default/http_retry.rs",
    "core/mod.rs",
    "saf/mod.rs",
    "saf/processor_svc_factory.rs",
    "saf/validator_svc_factory.rs"
  ],
  "aux": {
    "config": "api",
    "deny.toml": "both",
    "CHANGELOG.md": "api",
    "examples": "std",
    "docs": "std",
    "scripts": "std",
    "SECURITY.md": "both",
    ".gitignore": "both",
    "bootstrap.sh": "both",
    "bootstrap.ps1": "both"
  },
  "delete": [
    "README.md",
    "Cargo.toml",
    "tests/src/.gitkeep",
    "main/src/lib.rs"
  ],
  "text_rules": {
    "api/main/src/dto/decorate_response.rs": [
      [
        "pub layer: crate::RetryLayer,",
        "pub layer: std::sync::Arc<dyn crate::RetryLayer>,"
      ]
    ],
    "api/main/src/types/application_config_builder_impls.rs": [
      [
        "pub(crate) fn new() -> Self {",
        "pub fn new() -> Self {"
      ],
      [
        ".with_name(env!(\"CARGO_PKG_NAME\"))",
        ".with_name(\"edge-transport-http-egress-retry\")"
      ],
      [
        "assert_eq!(builder.name(), env!(\"CARGO_PKG_NAME\"));",
        "assert_eq!(builder.name(), \"edge-transport-http-egress-retry\");"
      ],
      [
        "impl ApplicationConfigBuilder {\n",
        "impl Default for ApplicationConfigBuilder {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\nimpl ApplicationConfigBuilder {\n"
      ]
    ],
    "api/main/src/traits/processor.rs": [
      [
        "/// Implemented by [`HttpRetrySvc`](crate::HttpRetrySvc) in `core/`.",
        "/// Implemented by the standard retry package, which builds it through [`RetryFactory`](crate::RetryFactory)."
      ]
    ],
    "std/main/src/core/svc_processor.rs": [
      [
        "pub struct HttpRetrySvc",
        "pub(crate) struct HttpRetrySvc"
      ]
    ]
  },
  "regex_rules": {
    "std/main/src/core/retry_layer.rs": [
      [
        "pub struct RetryLayer",
        "pub(crate) struct PolicyRetryLayer"
      ]
    ],
    "std/main/src/core/layer.rs": [
      [
        "use edge_transport_http_egress_retry_api::RetryLayer;\\n",
        "use super::retry_layer::PolicyRetryLayer;\\n"
      ],
      [
        "\\bRetryLayer\\b",
        "PolicyRetryLayer"
      ],
      [
        "debug_struct\\(\"PolicyRetryLayer\"\\)",
        "debug_struct(\"RetryLayer\")"
      ]
    ],
    "std/main/src/core/http_retry_svc.rs": [
      [
        "use edge_transport_http_egress_retry_api::HttpRetrySvc;\\n",
        "use super::svc_processor::HttpRetrySvc;\\n"
      ],
      [
        "use edge_transport_http_egress_retry_api::RetryLayer;\\n",
        "use super::retry_layer::PolicyRetryLayer;\\n"
      ],
      [
        "layer: RetryLayer::new\\(req\\.config\\),",
        "layer: std::sync::Arc::new(PolicyRetryLayer::new(req.config)),"
      ]
    ]
  },
  "std_names": [
    "StdRetryFactory"
  ],
  "trait_names": [
    "RetryFactory"
  ],
  "drop_names": [
    "HttpRetrySvc",
    "ProcessorFactory",
    "ValidatorFactory",
    "RetryLayer"
  ],
  "line_rules": [
    [
      "\\bHttpRetrySvc\\b(?!::)",
      "StdRetryFactory.create_processor()"
    ]
  ],
  "test_rules": [
    [
      "HttpRetrySvc::new_app_config_builder\\(\\)",
      "StdRetryFactory.new_app_config_builder()"
    ],
    [
      "HttpRetrySvc::new_config_builder\\(\\)",
      "StdRetryFactory.new_config_builder()"
    ],
    [
      "ProcessorFactory::create\\(\\)",
      "StdRetryFactory.create_processor()"
    ],
    [
      "ValidatorFactory::create\\(\\)",
      "StdRetryFactory.create_validator()"
    ],
    [
      ": RetryLayer\\b",
      ""
    ],
    [
      "(let _?as_dyn: &dyn reqwest_middleware::Middleware = )&layer;",
      "\\1&*layer;"
    ],
    [
      "fn assert_middleware<T: reqwest_middleware::Middleware>\\(_: T\\) \\{\\}\\s*assert_middleware\\(layer\\);",
      "let _as_middleware: std::sync::Arc<dyn reqwest_middleware::Middleware> = layer;"
    ],
    [
      "(let _arc: Arc<dyn reqwest_middleware::Middleware> = )Arc::new\\(layer\\);",
      "\\1layer;"
    ],
    [
      "\\.with\\((\\w*(?:layer|retry)\\w*)\\)",
      ".with_arc(\\1)"
    ],
    [
      "env!\\(\"CARGO_PKG_NAME\"\\)",
      "\"edge-transport-http-egress-retry\""
    ]
  ]
}
