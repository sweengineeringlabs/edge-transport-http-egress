#!/usr/bin/env bash
set -euo pipefail
# Ensure ~/.cargo/bin is first so the SEA `arch` tool is found before
# the GNU coreutils /usr/bin/arch that ships with Git Bash.
export PATH="$HOME/.cargo/bin:$PATH"
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCM_DIR="$REPO_ROOT/scm"
echo "pre-commit ── $(basename $REPO_ROOT) ──"
cd "$SCM_DIR"
echo "  1/4 fmt..."
# Run per-package to avoid Windows MAX_PATH (os error 206) with workspace-level cargo fmt.
for pkg in edge-transport-http-egress-cache edge-transport-http-egress-rate edge-transport-http-egress-retry \
            edge-transport-http-egress-breaker edge-transport-http-egress-loadbalancer \
            edge-transport-http-egress-cassette edge-transport-http-egress-transport; do
  cargo fmt -p "$pkg" -- --check
done
echo "  2/4 clippy..."
cargo clippy --workspace --all-targets -- -D warnings
echo "  3/4 arch audit..."
arch audit --rs
echo "  4/4 cargo audit..."
cargo audit --deny unsound --deny yanked
echo "pre-commit: all checks passed."
