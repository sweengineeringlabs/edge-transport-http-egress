#!/usr/bin/env bash
set -euo pipefail
# Ensure ~/.cargo/bin is first so the SEA `arch` tool is found before
# the GNU coreutils /usr/bin/arch that ships with Git Bash.
export PATH="$HOME/.cargo/bin:$PATH"
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCM_DIR="$REPO_ROOT/scm"
echo "pre-commit ── $(basename $REPO_ROOT) ──"
cd "$SCM_DIR"

PACKAGES="edge-transport-http-egress-cache-api edge-transport-http-egress-cache-std edge-transport-http-egress-rate-api edge-transport-http-egress-rate-std edge-transport-http-egress-retry-api edge-transport-http-egress-retry-std \
          edge-transport-http-egress-breaker-api edge-transport-http-egress-breaker-std edge-transport-http-egress-cassette-api edge-transport-http-egress-cassette-std \
          edge-transport-http-egress-resilient-api edge-transport-http-egress-resilient-std \
          edge-transport-http-egress-transport-api edge-transport-http-egress-transport-std"

echo "  1/4 fmt..."
# Run per-package to avoid Windows MAX_PATH (os error 206) with workspace-level cargo fmt.
for pkg in $PACKAGES; do
  cargo fmt -p "$pkg" -- --check
done

echo "  2/4 clippy..."
# Per-package so one member's pre-existing violations never block a commit
# scoped to a different, already-compliant member.
for pkg in $PACKAGES; do
  cargo clippy -p "$pkg" --all-targets -- -D warnings
done

echo "  3/4 arch audit..."
# arch audit operates on the current directory, so each member is audited
# from its own crate root — same reasoning as the clippy loop above.
#
# Baseline ratchet (issue #20). With arch 0.3.56 every member has findings that
# predate this gate (recorded 2026-11-05; none was introduced by the change that
# recorded it). The gate blocks any [FAIL] rule that is NOT in the member's
# baseline, and any [ERROR] other than the two known tool-internal ones, so a
# new violation of a rule the member does not already fail still stops the
# commit. Limits: a baselined rule is accepted member-wide, so a second offender
# of an already-failing rule is not caught; and the baseline is a record, not an
# endorsement — burn it down under #20, deleting entries as they are fixed.
#   - config_file_to_builder_naming: config/application.toml has no
#     <Name>ConfigBuilder because the configbuilder 0.8 migration replaced the
#     hand-written builders with the OptionalSection contract, which this arch
#     build does not recognise.
#   - the remaining entries are SEA layout/contract findings in members that
#     predate the rule set and are unfixed.
KNOWN_TOOL_ERRORS="test_coverage_threshold test_mutation_score"  # handlers not registered in arch 0.3.56
baseline_for() {
  case "$1" in
    # cassette-api / cassette-std: the same conflicts as breaker-api / breaker-std below; cassette-api keeps the
    #   config_file_to_builder_naming finding the cassette package already had.
    cassette-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names config_file_to_builder_naming" ;;
    cassette-std) echo "pub_types_in_api_only api_layer_mirrors_core_domains port_no_adapter_dep" ;;
    # cache-api / cache-std: the same conflicts and pre-existing finding as breaker-api / breaker-std below.
    cache-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names config_file_to_builder_naming" ;;
    cache-std) echo "pub_types_in_api_only api_layer_mirrors_core_domains port_no_adapter_dep" ;;
    # rate-api / rate-std: the same conflicts and pre-existing finding as breaker-api / breaker-std below.
    rate-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names config_file_to_builder_naming" ;;
    rate-std) echo "pub_types_in_api_only api_layer_mirrors_core_domains port_no_adapter_dep" ;;
    # -api: config_methods_pub_crate, package_name_no_sea_suffix and boundary_no_antipattern_names conflict
    #   with issue #30 (the package must be named -api and BreakerConfig::from_config must stay public);
    #   config_file_to_builder_naming is the configbuilder 0.8 OptionalSection gap described above.
    breaker-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names config_file_to_builder_naming" ;;
    # -std: pub_types_in_api_only and api_layer_mirrors_core_domains conflict with #30 (StdBreakerFactory is the
    #   public construction path and the contract lives in -api, so there is no api/ layer to mirror);
    #   port_no_adapter_dep reports a workspace-local dependency of a port-typed crate, a finding that predates the split.
    breaker-std) echo "pub_types_in_api_only api_layer_mirrors_core_domains port_no_adapter_dep" ;;
    # retry-api / retry-std: the same conflicts as breaker-api / breaker-std below. retry-api has no
    #   config_file_to_builder_naming because ApplicationConfigBuilder lives in it.
    retry-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names" ;;
    retry-std) echo "pub_types_in_api_only port_no_adapter_dep" ;;
    # resilient-api / resilient-std: the naming conflicts of every -api package; resilient-std also keeps the two
    #   conflicts of every -std package. The other findings the two packages carried before the split (#20) are fixed.
    resilient-api) echo "package_name_no_sea_suffix boundary_no_antipattern_names" ;;
    resilient-std) echo "pub_types_in_api_only port_no_adapter_dep" ;;
    # transport-api / transport-std: the same conflicts as breaker-api / breaker-std. The findings the transport
    #   package carried before the split (#20) are gone: the split removed them or they were fixed.
    transport-api) echo "config_methods_pub_crate package_name_no_sea_suffix boundary_no_antipattern_names" ;;
    transport-std) echo "pub_types_in_api_only api_layer_mirrors_core_domains port_no_adapter_dep" ;;
    *) echo "" ;;
  esac
}
for pkg_dir in cache-api cache-std rate-api rate-std retry-api retry-std breaker-api breaker-std cassette-api cassette-std resilient-api resilient-std transport-api transport-std; do
  AUDIT_OUTPUT="$(cd "$SCM_DIR/$pkg_dir" && arch audit --rs 2>&1)" && AUDIT_STATUS=0 || AUDIT_STATUS=$?
  echo "$AUDIT_OUTPUT"
  if [ "$AUDIT_STATUS" -ne 0 ]; then
    BASELINE="$(baseline_for "$pkg_dir")"
    FAILED_RULES="$(echo "$AUDIT_OUTPUT" | sed -n -E 's/^[[:space:]]*\[FAIL\] ([A-Za-z0-9_]+):.*/\1/p')"
    ERRORED_RULES="$(echo "$AUDIT_OUTPUT" | sed -n -E 's/^[[:space:]]*\[ERROR\] ([A-Za-z0-9_]+):.*/\1/p')"
    if [ -z "$FAILED_RULES$ERRORED_RULES" ]; then
      echo "arch audit failed in $pkg_dir with no [FAIL]/[ERROR] lines — see above."
      exit "$AUDIT_STATUS"
    fi
    UNEXPECTED=""
    for RULE in $FAILED_RULES; do
      case " $BASELINE " in *" $RULE "*) ;; *) UNEXPECTED="$UNEXPECTED $RULE" ;; esac
    done
    for RULE in $ERRORED_RULES; do
      case " $KNOWN_TOOL_ERRORS " in *" $RULE "*) ;; *) UNEXPECTED="$UNEXPECTED $RULE(error)" ;; esac
    done
    if [ -n "$UNEXPECTED" ]; then
      echo "arch audit: new findings in $pkg_dir, not in the baseline:$UNEXPECTED — see above."
      exit "$AUDIT_STATUS"
    fi
    echo "  ($pkg_dir: baselined findings only — not blocking)"
  fi
done

echo "  4/4 cargo audit..."
# Dependency-vulnerability scan against the shared workspace Cargo.lock —
# inherently workspace-wide, not a per-package compliance check.
cargo audit --deny unsound --deny yanked

echo "pre-commit: all checks passed."
